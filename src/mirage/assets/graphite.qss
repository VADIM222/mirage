QWidget { background: #151618; color: #E7E7E9; font-family: "Segoe UI"; font-size: 12px; }
QMainWindow { background: #151618; }
QFrame#sidebar { background: #1B1C1F; border-right: 1px solid #303136; }
QFrame#sidebar QWidget { background: transparent; }
QLabel#brand { font-size: 27px; font-weight: 650; padding: 14px 8px 24px 8px; }
QLabel#eyebrow { color: #747780; font-size: 10px; letter-spacing: 2px; padding: 0 8px 10px 8px; }
QLabel#title { font-size: 25px; font-weight: 600; }
QLabel#muted { color: #A5A6AF; }
QLabel#accent { color: #DFB47A; }
QLabel#section { font-size: 14px; font-weight: 600; }
QLabel#badge { color: #DFB47A; border: 1px solid #514333; border-radius: 4px; padding: 4px 8px; background: #25211C; }
QPushButton { background: #222326; border: 1px solid #303136; border-radius: 5px; padding: 8px 13px; }
QPushButton:hover { background: #2B2C30; border-color: #55565D; }
QPushButton:pressed { background: #333438; }
QPushButton:disabled { color: #747780; background: #1B1C1F; }
QPushButton#primary { color: #211C15; background: #DFB47A; border-color: #DFB47A; font-weight: 600; }
QPushButton#primary:hover { background: #EDC792; }
QPushButton#nav { text-align: left; color: #A5A6AF; background: transparent; border: none; padding: 12px 13px; }
QPushButton#nav:checked { background: #2B261F; color: #DFB47A; }
QPushButton#nav:hover { background: #252629; }
QTableView, QTreeWidget, QListWidget, QPlainTextEdit { border: 1px solid #303136; border-radius: 6px; background: #1B1C1F; selection-background-color: #302A23; selection-color: #E7E7E9; outline: none; }
QTableView::item { padding-left: 11px; border-bottom: 1px solid #292A2E; }
QTableView::item:selected { background: #302A23; }
QTableView { alternate-background-color: #202124; gridline-color: #303136; }
QHeaderView::section { background: #222326; color: #A5A6AF; border: none; padding: 9px 11px; text-align: left; }
QTableCornerButton::section { background: #222326; border: none; }
QTreeWidget::item { padding: 6px; }
QTreeWidget::item:selected { background: #302A23; }
QTabWidget::pane { border: none; border-top: 1px solid #303136; }
QTabBar::tab { color: #A5A6AF; background: transparent; padding: 11px 0; margin-right: 24px; border-bottom: 2px solid transparent; }
QTabBar::tab:selected { color: #E7E7E9; border-bottom: 2px solid #DFB47A; }
QLineEdit, QSpinBox, QComboBox { background: #222326; border: 1px solid #303136; border-radius: 4px; padding: 6px 9px; selection-background-color: #DFB47A; selection-color: #211C15; }
QLineEdit:focus, QSpinBox:focus, QComboBox:focus, QPlainTextEdit:focus { border-color: #DFB47A; }
QComboBox QAbstractItemView { border: 1px solid #303136; background: #222326; selection-background-color: #302A23; }
QCheckBox { spacing: 8px; }
QCheckBox::indicator, QTreeView::indicator, QListView::indicator { width: 14px; height: 14px; border: 2px solid #969BA6; border-radius: 3px; background: #222326; }
QCheckBox::indicator:hover, QTreeView::indicator:hover, QListView::indicator:hover { border-color: #EDC792; }
QCheckBox::indicator:checked, QTreeView::indicator:checked, QListView::indicator:checked { background: #DFB47A; border-color: #FFE0B5; image: url("__CHECK_ICON__"); }
QScrollBar:vertical { width: 8px; background: transparent; margin: 0; }
QScrollBar::handle:vertical { background: #42444B; border-radius: 4px; min-height: 24px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QSplitter::handle { background: #242529; height: 3px; }
QGroupBox { border: 1px solid #303136; border-radius: 6px; margin-top: 14px; padding: 15px; }
QGroupBox::title { subcontrol-origin: margin; left: 13px; padding: 0 5px; color: #A5A6AF; }
QToolTip { background: #28292D; color: #E7E7E9; border: 1px solid #55565D; padding: 6px; }
